# ==============================================================================
# CampusTrace - Unified Root Environment Variables Template
# ==============================================================================

NODE_ENV=development
PROJECT_NAME=CampusTrace

# Backend Server
PORT=5000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_cryptographically_secure_jwt_token_secret_key_32_characters
JWT_EXPIRES_IN=7d

# Set to true only if you want offline in-memory mock store without Azure SQL
USE_MOCK_DB=false

# Azure SQL Database (Microsoft Entra ID token-based authentication)
DB_AUTH_MODE=azure-identity
DB_SERVER=campustrace.database.windows.net
DB_PORT=1433
DB_NAME=CampusTraceDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Optional: Only needed when DB_AUTH_MODE=sql-password
DB_USER=
DB_PASSWORD=

# Optional: Azure Tenant ID
AZURE_TENANT_ID=

# Azure Blob Storage (Item Photographs & Claim Proofs)
AZURE_STORAGE_ACCOUNT=campustracestorage
AZURE_STORAGE_CONTAINER_NAME=campustrace-images
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=campustracestorage;AccountKey=your_storage_key==;EndpointSuffix=core.windows.net

# Azure Service Bus & Functions
AZURE_SERVICE_BUS_CONNECTION=Endpoint=sb://campustrace-bus.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_bus_key==
MATCHING_QUEUE_NAME=item-matching-jobs
NOTIFICATION_QUEUE_NAME=item-notifications

# Azure Application Insights Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=CampusTrace
NODE_ENV=development
PORT=5000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_cryptographically_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Set to true only if you want offline in-memory mock store without Azure SQL
USE_MOCK_DB=false

# Azure SQL Database Configuration
# Authentication modes: 'azure-identity' (Microsoft Entra ID token) or 'sql-password'
DB_AUTH_MODE=azure-identity
DB_SERVER=campustrace.database.windows.net
DB_PORT=1433
DB_NAME=CampusTraceDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Optional: Only needed when DB_AUTH_MODE=sql-password
DB_USER=
DB_PASSWORD=

# Optional: Azure Entra Tenant ID override
AZURE_TENANT_ID=

# Azure Blob Storage Configuration (Item Photographs & Proofs)
AZURE_STORAGE_ACCOUNT=campustracestorage
AZURE_STORAGE_CONTAINER=item-photos
AZURE_STORAGE_CONNECTION_STRING=

# Azure Application Insights Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=